<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Prevent duplicate assembly attributes when other assembly info is present -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Prevent duplicate TargetFrameworkAttribute generation when assembly attributes are managed separately -->
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same versions as CalcSaMD.Tests.csproj (Phase 1), for consistency
         across the solution. Generated by the test tooling, not hand-typed;
         yours may show newer patch numbers - that's expected, leave them. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- No global "using Xunit;" here - same convention as CalcSaMD.Tests:
       each test file includes its own explicit using statement instead. -->

  <ItemGroup>
    <ProjectReference Include="..\..\PipelineSimulator.csproj" />
  </ItemGroup>

</Project>
