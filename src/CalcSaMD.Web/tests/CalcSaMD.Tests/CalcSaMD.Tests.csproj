<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Prevent duplicate assembly attributes when other assembly info is present -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Prevent duplicate TargetFrameworkAttribute generation when assembly attributes are managed separately -->
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by the test tooling, not hand-typed. Yours may show newer
         patch numbers than these; that's expected, leave them. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- No global "using Xunit;" here — each test file includes its own
       explicit using statement instead. Either approach works; this
       reference solution states it explicitly so nothing is implicit. -->

  <ItemGroup>
    <ProjectReference Include="..\..\..\CalcSaMD.Core\CalcSaMD.Core.csproj" />
  </ItemGroup>

</Project>
